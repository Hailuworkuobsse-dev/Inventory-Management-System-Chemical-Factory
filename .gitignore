```
# Dependencies
node_modules/

# Build artifacts
dist/
build/
target/

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python cache (if any Python files exist in project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Testing
.nyc_output/
coverage-final.json

# OS generated files
.DS_Store
Thumbs.db

# Docker (preserving your Dockerfile and docker-compose.yml)
.dockerenv
!Dockerfile
!docker-compose.yml

# Runtime data
*.pid
*.seed
*.pem

# Debug log
debug.log

# Local configuration
config/local.*
!src/config/database.js

# NPM packages
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ESLint and Prettier cache
.eslintcache
.prettierignore

# Node.js
node/
npm/
*.tgz

# Lock files
package-lock.json
yarn.lock

# Development tools
.nodemonignore
!nodemon.json
```